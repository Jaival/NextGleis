# Sent as the User-Agent to the HAFAS networks (RMV, VBB, …) so their operators
# can tell who is calling. Defaults to "NextGleis (<repo URL>)"; override with
# something that identifies your deployment, e.g. a URL or a contact address.
# A bare name like "NextGleis" is rejected by VBB.
HAFAS_USER_AGENT="NextGleis/1.0 (https://github.com/Jaival/NextGleis)"

# Optional — only used as a fallback for stations saved in older app versions
# that no HAFAS network can place. From My Apps -> your application
# (developers.deutschebahn.com), subscribed to the "Timetables" product.
DB_CLIENT_ID=
DB_API_KEY=

# Optional override — defaults to the Timetables product's documented endpoint.
# Only set this if DB migrates the marketplace again.
# DB_API_BASE_URL=https://apis.deutschebahn.com/db-api-marketplace/apis/timetables/v1
